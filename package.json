{
  "name": "cozy-circuit-connections",
  "version": "0.1.0",
  "private": true,
  "description": "A cozy browser matching puzzle with cartoon components, shields, walls, and a 12-stage campaign.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "export": "npm run build && node scripts/export.mjs && node tests/export.mjs",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "test": "node tests/run.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:generate": "node scripts/generate-icons.mjs",
    "revision": "node scripts/revision.mjs --bump",
    "version:sync": "node scripts/revision.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.7"
  },
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@fontsource-variable/fredoka": "^5.3.0"
  }
}
